import { CaptionLook, CaptionWord, CaptionWords } from "captions.slint";

component ControlButton {
    in property <string> label;
    in property <string> icon;
    in property <string> glyph;
    in property <float> glyph-size: 13;
    out property <bool> pointed-at: touch.has-hover;
    callback clicked <=> touch.clicked;
    width: 30px;
    height: 26px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        touch.clicked();
    }
    Rectangle {
        border-radius: 7px;
        background: touch.has-hover ? #ffffff24 : transparent;
        animate background { duration: 90ms; }
    }

    if root.glyph != "": Text {
        text: root.glyph;
        color: white;
        font-size: root.glyph-size * 1px;
        font-weight: 700;
    }
    if root.icon != "": Path {
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: root.icon;
        stroke: white;
        stroke-width: 1.6px;
        fill: transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

// Shows where to grab, because the resize cursor may not appear while another app is in front.
component EdgeHandles {
    in property <color> ink;
    property <length> long: 34px;
    property <length> thick: 4px;
    property <length> gap: 3px;
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.gap;
        width: root.long;
        height: root.thick;
        border-radius: 2px;
        background: root.ink;
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - root.gap;
        width: root.long;
        height: root.thick;
        border-radius: 2px;
        background: root.ink;
    }

    Rectangle {
        x: root.gap;
        y: (root.height - self.height) / 2;
        width: root.thick;
        height: root.long;
        border-radius: 2px;
        background: root.ink;
    }

    Rectangle {
        x: root.width - self.width - root.gap;
        y: (root.height - self.height) / 2;
        width: root.thick;
        height: root.long;
        border-radius: 2px;
        background: root.ink;
    }
}

// The captions, floating over everything else. The window itself is clear, so only the rounded
// panel shows. Controls appear on hover, which keeps the default view to nothing but text.
export component CaptionOverlay inherits Window {
    title: "Soundveil captions";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    min-width: 400px;
    min-height: 90px;
    preferred-width: 850px;
    preferred-height: 156px;
    in property <[CaptionWord]> words;
    in property <string> placeholder;
    in property <float> size-points: 28;
    in property <bool> expanded;
    callback smaller();
    callback larger();
    callback toggle-expanded();
    callback click-through();
    callback hide-overlay();
    callback move-window();
    // Sides are bits: 1 left, 2 right, 4 bottom, 8 top. The Rust side decides which apply.
    callback resize-window(int);
    pure callback edges-at(length, length, length, length) -> int;

    property <length> inset: 6px;
    property <bool> quiet: root.words.length == 0 && root.placeholder == "";
    // A tooltip may not show on a window without focus, so the buttons name themselves.
    property <string> hint: smaller.pointed-at ? smaller.label : larger.pointed-at ? larger.label : expand.pointed-at ? expand.label : pass.pointed-at ? pass.label : close.pointed-at ? close.label : "";
    property <int> edges: drag.has-hover ? root.edges-at(drag.mouse-x, drag.mouse-y, root.width, root.height) : 0;

    // The rest sits inside this area, because it only counts as hovered while the pointer is on it
    // or on something inside it. As a sibling behind the controls, it would lose the pointer to
    // them and take them away.
    drag := TouchArea {
        mouse-cursor: root.edges == 1 || root.edges == 2 ? MouseCursor.ew-resize : root.edges == 4 || root.edges == 8 ? MouseCursor.ns-resize : root.edges == 9 || root.edges == 6 ? MouseCursor.nwse-resize : root.edges == 10 || root.edges == 5 ? MouseCursor.nesw-resize : MouseCursor.default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                if root.edges == 0 {
                    root.move-window();
                } else {
                    root.resize-window(root.edges);
                }
            }
        }

        panel := Rectangle {
            x: root.inset;
            y: root.inset;
            width: root.width - root.inset * 2;
            height: root.height - root.inset * 2;
            border-radius: 16px;
            background: root.quiet && !drag.has-hover ? #0000000d : #000000c7;
            animate background { duration: 140ms; }

            CaptionWords {
                x: 22px;
                y: 14px;
                width: parent.width - 44px;
                height: parent.height - 28px;
                words: root.words;
                placeholder: root.placeholder;
                size: root.size-points;
            }

            EdgeHandles {
                width: parent.width;
                height: parent.height;
                ink: CaptionLook.text.with-alpha(0.45);
                opacity: drag.has-hover ? 1 : 0;
                animate opacity { duration: 140ms; }
            }
        }

        bar := Rectangle {
            x: root.width - self.width - root.inset - 7px;
            y: root.inset + 7px;
            width: buttons.preferred-width + 6px;
            height: 28px;
            border-radius: 14px;
            background: #000000b8;
            border-width: 1px;
            border-color: #ffffff24;
            opacity: drag.has-hover ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: 140ms; }

            buttons := HorizontalLayout {
                padding-left: 3px;
                padding-right: 3px;
                padding-top: 1px;
                padding-bottom: 1px;
                smaller := ControlButton {
                    label: "Smaller text";
                    glyph: "A";
                    glyph-size: 11;
                    clicked => {
                        root.smaller();
                    }
                }

                larger := ControlButton {
                    label: "Larger text";
                    glyph: "A";
                    glyph-size: 16;
                    clicked => {
                        root.larger();
                    }
                }

                expand := ControlButton {
                    label: root.expanded ? "Collapse" : "Expand";
                    icon: root.expanded ? "M 1 13 L 5.5 8.5 M 5.5 13 L 5.5 8.5 L 1 8.5 M 13 1 L 8.5 5.5 M 8.5 1 L 8.5 5.5 L 13 5.5" : "M 5.5 8.5 L 1 13 M 1 8.5 L 1 13 L 5.5 13 M 8.5 5.5 L 13 1 M 8.5 1 L 13 1 L 13 5.5";
                    clicked => {
                        root.toggle-expanded();
                    }
                }

                pass := ControlButton {
                    label: "Let clicks pass through";
                    icon: "M 3 2 L 3 11 L 5.6 8.8 L 7.4 12.6 L 9.2 11.8 L 7.4 8.1 L 10.8 8 Z";
                    clicked => {
                        root.click-through();
                    }
                }

                close := ControlButton {
                    label: "Hide overlay";
                    icon: "M 2.5 2.5 L 11.5 11.5 M 11.5 2.5 L 2.5 11.5";
                    clicked => {
                        root.hide-overlay();
                    }
                }
            }
        }

        if root.hint != "": Rectangle {
            x: root.width - self.width - root.inset - 7px;
            y: bar.y + bar.height + 4px;
            width: name.preferred-width + 18px;
            height: 20px;
            border-radius: 10px;
            background: #000000b8;
            name := Text {
                text: root.hint;
                color: white;
                font-size: 11px;
                font-weight: 500;
            }
        }

        Path {
            x: root.width - 26px - root.inset;
            y: root.height - 26px - root.inset;
            width: 22px;
            height: 22px;
            viewbox-width: 22;
            viewbox-height: 22;
            commands: "M 20 8 L 8 20 M 20 13 L 13 20 M 20 18 L 18 20";
            stroke: CaptionLook.text.with-alpha(0.55);
            stroke-width: 1.6px;
            fill: transparent;
            opacity: drag.has-hover ? 1 : 0;
            animate opacity { duration: 140ms; }
        }
    }
}
