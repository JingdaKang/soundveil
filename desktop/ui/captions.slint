// Live captions, shared by the overlay and the preview in the main window.

export struct CaptionWord {
    text: string,
    // 0 plain, 1 a sound word or slang, 2 a sound label, 3 the end of a line.
    kind: int,
    settled: bool,
}

export struct CaptionAppearance {
    text: color,
    background: color,
    highlight: color,
    background-opacity: float,
    text-opacity: float,
    shadowed: bool,
    edge: color,
}

export global CaptionLook {
    in property <CaptionAppearance> style: {
        text: #ffffff,
        background: #000000,
        highlight: #ffd14d,
        background-opacity: 0.78,
        text-opacity: 1,
        shadowed: false,
        edge: #000000,
    };
}

// With little background behind it, text needs an edge of its own or it vanishes against a video
// of the same color. Text has no shadow in Slint, so copies around it stand in for one: a firm one
// just below, and a faint ring. Copies look the same on every renderer, which a stroke doesn't.
export component TextShadow {
    in property <string> text;
    in property <color> edge;
    in property <length> font-size;
    in property <int> font-weight;
    in property <TextVerticalAlignment> vertical-alignment: top;
    in property <TextOverflow> overflow: clip;
    property <[{x: length, y: length, alpha: float}]> copies: [
        { x: 0px, y: 1px, alpha: 0.9 },
        { x: -1px, y: 0px, alpha: 0.35 },
        { x: 1px, y: 0px, alpha: 0.35 },
        { x: 0px, y: -1px, alpha: 0.35 },
        { x: -1.5px, y: 1.5px, alpha: 0.2 },
        { x: 1.5px, y: 1.5px, alpha: 0.2 },
    ];
    for copy in root.copies: Text {
        x: copy.x;
        y: copy.y;
        width: root.width;
        height: root.height;
        text: root.text;
        color: root.edge.with-alpha(copy.alpha);
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: root.vertical-alignment;
        overflow: root.overflow;
        wrap: no-wrap;
    }
}

component WordCell {
    in property <CaptionWord> word;
    in property <float> size;
    in property <length> full-width;
    property <length> line: round(root.size * 1.3) * 1px;
    property <bool> landed: false;
    property <bool> cue: root.word.kind == 2;
    property <bool> accent: root.word.kind == 1;
    property <color> ink: root.cue || root.accent ? CaptionLook.style.highlight : CaptionLook.style.text;
    property <length> text-size: (root.cue ? root.size * 0.68 : root.accent ? root.size * 1.1 : root.size) * 1px;
    property <int> weight: root.accent ? 700 : 600;

    init => {
        self.landed = true;
    }
    width: root.word.kind == 3 ? root.full-width : label.preferred-width + (root.cue ? 20px : 0px);
    height: root.word.kind == 3 ? 0px : root.line;
    opacity: !root.landed ? 0 : root.word.settled ? 1 : 0.62;
    animate opacity { duration: 160ms; easing: ease-out; }

    if root.cue: Rectangle {
        y: (root.line - self.height) / 2 + root.size * 0.06px;
        height: root.size * 1.02px;
        border-radius: self.height / 2;
        background: root.ink.with-alpha(0.14);
        border-width: 1px;
        border-color: root.ink.with-alpha(0.45);
    }
    if CaptionLook.style.shadowed: TextShadow {
        x: label.x;
        y: label.y;
        width: label.width;
        height: label.height;
        text: root.word.text;
        edge: CaptionLook.style.edge;
        font-size: root.text-size;
        font-weight: root.weight;
    }
    label := Text {
        x: root.cue ? 10px : 0px;
        y: root.cue ? (root.line - self.preferred-height) / 2 + root.size * 0.06px : root.line - self.preferred-height;
        text: root.word.text;
        color: root.ink;
        font-size: root.text-size;
        font-weight: root.weight;
        wrap: no-wrap;
    }
}

// Roll-up captions: left-aligned, with the newest line at the bottom.
export component CaptionWords {
    in property <[CaptionWord]> words;
    in property <string> placeholder;
    in property <float> size: 28;
    property <length> line: round(root.size * 1.3) * 1px;
    // Only whole lines, so the oldest is never cut through the middle.
    property <int> rows: max(1, floor(root.height / root.line));
    property <bool> waiting: root.words.length == 0 && root.placeholder != "";
    accessible-role: text;
    accessible-label: "Live captions";
    opacity: CaptionLook.style.text-opacity;

    if root.waiting && CaptionLook.style.shadowed: TextShadow {
        width: root.width;
        height: root.height;
        text: root.placeholder;
        edge: CaptionLook.style.edge;
        font-size: min(root.size, 24) * 1px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.waiting: Text {
        width: root.width;
        height: root.height;
        text: root.placeholder;
        color: CaptionLook.style.text.with-alpha(0.6);
        font-size: min(root.size, 24) * 1px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        y: (root.height - self.height) / 2;
        width: root.width;
        height: root.rows * root.line;
        clip: true;
        FlexboxLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            flex-direction: row;
            flex-wrap: wrap;
            cross-axis-line-alignment: end;
            cross-axis-alignment: end;
            spacing-horizontal: round(root.size * 0.26) * 1px;
            spacing-vertical: 0px;
            for word in root.words: WordCell {
                word: word;
                size: root.size;
                full-width: root.width;
            }
        }
    }
}
