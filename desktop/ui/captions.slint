// Live captions, shared by the overlay and the preview in the main window.

export struct CaptionWord {
    text: string,
    // 0 plain, 1 a sound word or slang, 2 a sound label, 3 the end of a line.
    kind: int,
    settled: bool,
}

export struct CaptionAppearance {
    text: color,
    background: color,
    highlight: color,
    // Highlighted words are filled from this at the top down to the highlight color.
    highlight-top: color,
    background-opacity: float,
    text-opacity: float,
    shadowed: bool,
    edge: color,
    // Light text on a dark surround, where a highlighted word can glow.
    glows: bool,
    // The typeface. An empty family is the interface's own font.
    family: string,
    weight: int,
    // For sound words and slang.
    strong-weight: int,
}

export global CaptionLook {
    in property <CaptionAppearance> style: {
        text: #f5f2ea,
        background: #000000,
        highlight: #ffc233,
        highlight-top: #ffda85,
        background-opacity: 0.78,
        text-opacity: 1,
        shadowed: false,
        edge: #000000,
        glows: true,
        family: "",
        weight: 600,
        strong-weight: 700,
    };
    // A highlighted word or a cue, filled top to bottom. The base color comes first, because a
    // renderer that can't fill text with a gradient uses the first color alone.
    out property <brush> accent: @linear-gradient(0deg, self.style.highlight 0%, self.style.highlight-top 100%);
}

// With little background behind it, text needs an edge of its own or it vanishes against a video
// of the same color. Text has no shadow in Slint, so copies around it stand in for one: a firm one
// just below, and a faint ring. Copies look the same on every renderer, which a stroke doesn't.
export component TextShadow {
    in property <string> text;
    in property <color> edge;
    in property <length> font-size;
    in property <int> font-weight;
    in property <string> font-family;
    in property <TextVerticalAlignment> vertical-alignment: top;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextOverflow> overflow: clip;
    property <[{x: length, y: length, alpha: float}]> copies: [
        { x: 0px, y: 1px, alpha: 0.9 },
        { x: -1px, y: 0px, alpha: 0.35 },
        { x: 1px, y: 0px, alpha: 0.35 },
        { x: 0px, y: -1px, alpha: 0.35 },
        { x: -1.5px, y: 1.5px, alpha: 0.2 },
        { x: 1.5px, y: 1.5px, alpha: 0.2 },
    ];
    for copy in root.copies: Text {
        x: copy.x;
        y: copy.y;
        width: root.width;
        height: root.height;
        text: root.text;
        color: root.edge.with-alpha(copy.alpha);
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        vertical-alignment: root.vertical-alignment;
        horizontal-alignment: root.horizontal-alignment;
        overflow: root.overflow;
        wrap: no-wrap;
    }
}

// A soft glow behind a highlighted word, so it reads as an accent rather than as text that happens
// to be another color. Like the shadow it is faint copies of the text: two rings of them, the
// outer one fainter, which fade out over a fifth of the text's size.
component TextGlow {
    in property <string> text;
    in property <color> glow;
    in property <length> font-size;
    in property <int> font-weight;
    in property <string> font-family;
    property <length> near: root.font-size * 0.07;
    property <length> far: root.font-size * 0.15;
    property <[{x: float, y: float}]> around: [
        { x: 1, y: 0 },
        { x: 0.71, y: 0.71 },
        { x: 0, y: 1 },
        { x: -0.71, y: 0.71 },
        { x: -1, y: 0 },
        { x: -0.71, y: -0.71 },
        { x: 0, y: -1 },
        { x: 0.71, y: -0.71 },
    ];
    // The outer ring sits between the inner one's directions, which hides the steps.
    property <[{x: float, y: float}]> between: [
        { x: 0.92, y: 0.38 },
        { x: 0.38, y: 0.92 },
        { x: -0.38, y: 0.92 },
        { x: -0.92, y: 0.38 },
        { x: -0.92, y: -0.38 },
        { x: -0.38, y: -0.92 },
        { x: 0.38, y: -0.92 },
        { x: 0.92, y: -0.38 },
    ];
    for way in root.between: Text {
        x: way.x * root.far;
        y: way.y * root.far;
        width: root.width;
        height: root.height;
        text: root.text;
        color: root.glow.with-alpha(0.045);
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        wrap: no-wrap;
    }
    for way in root.around: Text {
        x: way.x * root.near;
        y: way.y * root.near;
        width: root.width;
        height: root.height;
        text: root.text;
        color: root.glow.with-alpha(0.075);
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        wrap: no-wrap;
    }
}

// One word as drawn, shared by the overlay and the preview in Settings.
component WordCell {
    in property <CaptionWord> word;
    in property <float> size;
    in property <length> full-width;
    // On a line above the newest, so it has been read.
    in property <bool> read;
    property <length> line: round(root.size * 1.3) * 1px;
    property <bool> landed: false;
    property <bool> cue: root.word.kind == 2;
    property <bool> accent: root.word.kind == 1;
    // Highlighted words are a little larger, and a cue is a small pill.
    property <length> text-size: (root.cue ? root.size * 0.66 : root.accent ? root.size * 1.08 : root.size) * 1px;
    property <int> weight: root.accent ? CaptionLook.style.strong-weight : CaptionLook.style.weight;
    // Highlights and cues barely dim, whether tentative or read: a faded accent color turns muddy.
    property <float> settled: root.word.settled ? 1 : root.word.kind == 0 ? 0.62 : 0.8;
    property <float> stepped-back: !root.read ? 1 : root.word.kind == 0 ? 0.78 : 0.94;

    init => {
        self.landed = true;
    }
    width: root.word.kind == 3 ? root.full-width : label.preferred-width + (root.cue ? 20px : 0px);
    height: root.word.kind == 3 ? 0px : root.line;
    opacity: !root.landed ? 0 : root.settled * root.stepped-back;
    animate opacity { duration: 160ms; easing: ease-out; }

    if root.cue: Rectangle {
        y: (root.line - self.height) / 2 + root.size * 0.06px;
        height: root.size * 1.04px;
        border-radius: self.height / 2;
        background: @linear-gradient(180deg, CaptionLook.style.highlight.with-alpha(0.2) 0%, CaptionLook.style.highlight.with-alpha(0.1) 100%);
        border-width: 1px;
        border-color: CaptionLook.style.highlight.with-alpha(0.4);
    }
    if CaptionLook.style.shadowed: TextShadow {
        x: label.x;
        y: label.y;
        width: label.width;
        height: label.height;
        text: root.word.text;
        edge: CaptionLook.style.edge;
        font-size: root.text-size;
        font-weight: root.weight;
        font-family: CaptionLook.style.family;
    }
    if root.accent && CaptionLook.style.glows: TextGlow {
        x: label.x;
        y: label.y;
        width: label.width;
        height: label.height;
        text: root.word.text;
        glow: CaptionLook.style.highlight;
        font-size: root.text-size;
        font-weight: root.weight;
        font-family: CaptionLook.style.family;
    }
    label := Text {
        x: root.cue ? 10px : 0px;
        y: root.cue ? (root.line - self.preferred-height) / 2 + root.size * 0.06px : root.line - self.preferred-height;
        text: root.word.text;
        color: root.cue || root.accent ? CaptionLook.accent : CaptionLook.style.text;
        font-size: root.text-size;
        font-weight: root.weight;
        font-family: CaptionLook.style.family;
        wrap: no-wrap;
    }
}

// One line that shows each kind of word, for judging a style before using it.
export component CaptionSample inherits HorizontalLayout {
    in property <float> size: 18;
    spacing: root.size * 0.3px;
    opacity: CaptionLook.style.text-opacity;
    WordCell {
        word: { text: "Captions look like this,", kind: 0, settled: true };
        size: root.size;
    }

    WordCell {
        word: { text: "whoa", kind: 1, settled: true };
        size: root.size;
    }

    WordCell {
        word: { text: "♪ music", kind: 2, settled: true };
        size: root.size;
    }
}

// Roll-up captions: left-aligned, with the newest line at the bottom.
export component CaptionWords {
    in property <[CaptionWord]> words;
    in property <string> placeholder;
    in property <float> size: 28;
    // The line being spoken is the brightest thing on the panel, and lines already read step
    // back. Reading back is the exception, so nothing dims while the overlay is expanded.
    in property <bool> dims-read: true;
    property <length> line: round(root.size * 1.3) * 1px;
    // Only whole lines, so the oldest is never cut through the middle.
    property <int> rows: max(1, floor(root.height / root.line));
    property <bool> waiting: root.words.length == 0 && root.placeholder != "";
    accessible-role: text;
    accessible-label: "Live captions";
    opacity: CaptionLook.style.text-opacity;

    if root.waiting && CaptionLook.style.shadowed: TextShadow {
        width: root.width;
        height: root.height;
        text: root.placeholder;
        edge: CaptionLook.style.edge;
        font-size: min(root.size, 24) * 1px;
        font-weight: CaptionLook.style.weight;
        font-family: CaptionLook.style.family;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.waiting: Text {
        width: root.width;
        height: root.height;
        text: root.placeholder;
        color: CaptionLook.style.text.with-alpha(0.6);
        font-size: min(root.size, 24) * 1px;
        font-weight: CaptionLook.style.weight;
        font-family: CaptionLook.style.family;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        y: (root.height - self.height) / 2;
        width: root.width;
        height: root.rows * root.line;
        clip: true;
        flow := FlexboxLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            flex-direction: row;
            flex-wrap: wrap;
            cross-axis-line-alignment: end;
            cross-axis-alignment: end;
            spacing-horizontal: round(root.size * 0.26) * 1px;
            spacing-vertical: 0px;
            // Lines are packed against the bottom, so the newest is the last line's height up
            // from it, and a word that ends above there is on a line already read.
            for word in root.words: WordCell {
                word: word;
                size: root.size;
                full-width: root.width;
                read: root.dims-read && self.y + self.height < flow.height - root.line / 2;
            }
        }
    }
}
