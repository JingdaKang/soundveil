    "Keeps the GPU under about half load on this Mac, and slows down in Low Power Mode or when it's hot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die GPU auf diesem Mac unter etwa halber Last und wird im Stromsparmodus oder bei Hitze langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la GPU por debajo de la mitad de su carga en este Mac y va más despacio en Modo de bajo consumo o cuando se calienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient la charge du GPU sous la moitié environ sur ce Mac et ralentit en mode économie d’énergie ou quand il chauffe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのGPU負荷を約半分以下に保ち、低電力モードのときや本体が熱いときは更新を遅くします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 GPU 부하를 절반 정도 아래로 유지하고, 저전력 모드이거나 기기가 뜨거우면 속도를 늦춥니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让这台 Mac 的 GPU 负载保持在约一半以下，并在低电量模式下或机器发热时放慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓這台 Mac 的 GPU 負載維持在約一半以下，並在低耗電模式下或機器過熱時放慢。"
          }
        }
      }
    },
