    "Text gets a soft shadow so it stays readable over the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text erhält einen weichen Schatten, damit er über dem Video lesbar bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto lleva una sombra suave para que se lea bien sobre el vídeo."
