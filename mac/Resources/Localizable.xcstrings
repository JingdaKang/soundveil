          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルを読み込み中です。初回は最大1分ほどかかります…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델을 불러오는 중입니다. 처음 실행할 때는 최대 1분 정도 걸릴 수 있습니다…"
          }
        },
