          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtítulos en directo para vídeos y emisiones de Chrome. El audio no sale de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous-titres en direct pour les vidéos et les diffusions dans Chrome. L’audio reste sur ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
