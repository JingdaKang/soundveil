    "Soundveil can't record audio yet. Turn it on in Privacy Settings, then reopen Soundveil." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveil kann noch kein Audio aufnehmen. Aktiviere es in den Datenschutzeinstellungen und öffne Soundveil erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveil aún no puede grabar audio. Actívalo en los ajustes de privacidad y vuelve a abrir Soundveil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveil ne peut pas encore enregistrer l’audio. Activez-le dans les réglages de confidentialité, puis rouvrez Soundveil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveilはまだオーディオを録音できません。プライバシー設定でオンにしてから、Soundveilを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveil이 아직 오디오를 녹음할 수 없습니다. 개인정보 보호 설정에서 켠 다음 Soundveil을 다시 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveil 还不能录制音频。请在隐私设置中打开，然后重新打开 Soundveil。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soundveil 尚無法錄製音訊。請在隱私權設定中開啟，然後重新打開 Soundveil。"
          }
        }
      }
    },
